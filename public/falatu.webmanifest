{
  "name": "Fala Tu",
  "short_name": "Fala Tu",
  "description": "Do pensamento para a vida. Fala → Faz → Confere: capture por voz, foto ou texto — a IA organiza, você confirma.",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#0e1a2e",
  "background_color": "#0e1a2e",
  "icons": [
    {
      "src": "/falatu-brand/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/falatu-brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/falatu-brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/falatu-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["audio/*", "image/*"]
        }
      ]
    }
  }
}
